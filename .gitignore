# Maven build directories
**/target/

# IDE files
.idea/
*.iml
.vscode/

# OS files
.DS_Store

# JDK installations should not be committed
jdk17/

# NetBeans branding lives in directories NAMED after the jars they brand
# (core.jar/, org-netbeans-core.jar/). A global "*.jar" ignore would eat
# them silently - this re-includes everything under nbm-branding.
!branding/src/main/nbm-branding/**
# ...and under nbm-mnemonics, whose folders are named the same way.
!branding/src/main/nbm-mnemonics/**

# The tools module has a real Java package named "build". A global
# "build/" ignore would eat new files in it silently - keep it visible.
!tools/src/main/java/org/nmox/studio/tools/build/
!tools/src/test/java/org/nmox/studio/tools/build/

# session walk fixtures, throwaway userdirs and cache dirs — never part of a release
scratchpad/

# ./run.sh keeps the development instance's settings and caches beside the
# checkout, never in an installed copy's userdir
/userdir/
/userdir-cache/
