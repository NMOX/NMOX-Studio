<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE bindings PUBLIC "-//NetBeans//DTD Editor KeyBindings settings 1.1//EN"
                          "http://www.netbeans.org/dtds/EditorKeyBindings-1_1.dtd">
<!--
    GENERATED by scripts/generate-vscode-keymap.sh - do not edit.
    The VS Code keymap profile, Linux: what differs from the every-OS file.
    The default profile's bindings with scripts/vscode-keymap/chords.txt laid over them;
    every key is spelled with explicit modifiers (S Shift, C Ctrl, A Alt, M Cmd).
-->
<bindings>
    <bind key="CA-DOWN" remove="true"/>
    <bind key="CA-UP" remove="true"/>
    <bind actionName="add-caret-down" key="SA-DOWN"/>
    <bind actionName="add-caret-up" key="SA-UP"/>
    <bind actionName="copy-selection-else-line-down" key="SCA-DOWN"/>
    <bind actionName="copy-selection-else-line-up" key="SCA-UP"/>
    <bind actionName="format" key="SC-I"/>
    <bind actionName="jump-list-next" key="SC-MINUS"/>
    <bind actionName="jump-list-prev" key="CA-MINUS"/>
    <bind actionName="nmox-toggle-block-comment" key="SC-A"/>
</bindings>
