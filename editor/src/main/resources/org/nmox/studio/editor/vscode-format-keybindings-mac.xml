<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE bindings PUBLIC "-//NetBeans//DTD Editor KeyBindings settings 1.1//EN"
                          "http://www.netbeans.org/dtds/EditorKeyBindings-1_1.dtd">
<!--
    3.2: VS Code's macOS Format Document, Shift+Opt+F, on the platform's
    format action (Ctrl+Shift+F keeps working).

    macOS only (nbeditor-settings-targetOS=OS_MAC in the layer): on Windows
    and Linux the platform's own format chord, O-S-F, already IS
    Alt+Shift+F, VS Code's chord there.

    Registered in the NetBeans, Eclipse, Emacs and NetBeans55 profiles.
    Measured in the assembled cluster: the Idea profile binds Alt+Shift+F
    to Add to Favorites - a profile's own meaning of a chord wins there.
-->
<bindings>
    <bind actionName="format" key="AS-F"/>
</bindings>
