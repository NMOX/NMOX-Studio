<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE bindings PUBLIC "-//NetBeans//DTD Editor KeyBindings settings 1.1//EN"
                          "http://www.netbeans.org/dtds/EditorKeyBindings-1_1.dtd">
<!--
    Toggle Block Comment on VS Code's LINUX chord, Ctrl+Shift+A (VS Code
    uses Shift+Alt+A on Windows and Shift+Opt+A on macOS; see
    vscode-block-comment-keybindings.xml).

    Linux only: the layer gives this file nbeditor-settings-targetOS=OS_LINUX.
    The editor settings storage reads that attribute as the name of a
    BaseUtilities field and loads the file when the field's bit is set in
    getOperatingSystem() (SettingsType$DefaultLocator, RELEASE310 bytecode).

    Measured in the assembled cluster: Ctrl+Shift+A is free on Linux in
    all five profiles, editor and global, so the file rides all five. (On
    macOS the Eclipse and NetBeans 5.5 profiles bind it, as O-S-A; this
    file is not read there.)
-->
<!--
    The modifiers are written Shift first: the platform's keymap reader
    logs a WARNING at every start for a key that BEGINS with A or C in
    the default profile, and the order of the modifier letters means
    nothing to the key itself.
-->
<bindings>
    <bind actionName="nmox-toggle-block-comment" key="SC-A"/>
</bindings>
