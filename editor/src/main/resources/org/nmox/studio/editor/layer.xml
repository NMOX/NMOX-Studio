    <!-- The platform's HtmlLoader registers in text/html/Factories with
         NO position while our WebFileSupport (generated layer) sits at
         979 — mixed positioned/unpositioned children log the Ordering
         "Not all children ... marked with the position attribute"
         warning on every boot, and the relative order is formally
         unspecified. Pinning the platform instance at 1100 keeps the
         de-facto order (ours first — WebFileSupport has owned text/html
         since v0.1; unpositioned entries already sorted last) and makes
         it specified. Attribute-only merge: the instance itself still
         comes from the html module. -->
    <folder name="Loaders">
        <folder name="text">
            <folder name="html">
                <folder name="Factories">
                    <file name="org-netbeans-modules-html-HtmlLoader.instance">
                        <attr name="position" intvalue="1100"/>
                    </file>
                </folder>
            </folder>
        </folder>
    </folder>
    <!-- Suffixless Angular templates (ledger 82): NO programmatic
         MIMEResolver registration can work here — decompiled
         MIMESupport$CachedFileObject.getResolvers() consults ALL
         declarative XML resolvers (including the platform's ext=html)
         BEFORE any Lookup-provided resolver, so an .instance in this
         folder never sees an .html file no matter its position. The
         v1.346.0 .instance was proven inert live (2026-08-11) and
         removed; suffixless recognition needs a different mechanism. -->
</filesystem>
