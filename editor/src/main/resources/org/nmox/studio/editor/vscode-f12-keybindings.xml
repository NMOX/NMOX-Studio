<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE bindings PUBLIC "-//NetBeans//DTD Editor KeyBindings settings 1.1//EN"
                          "http://www.netbeans.org/dtds/EditorKeyBindings-1_1.dtd">
<!--
    3.2: F12 goes to the definition, as it does in VS Code on every OS.
    The action is the one Cmd+B has always run here (goto-declaration,
    Editors/Actions), so F12 and Cmd+B are the same gesture.

    Registered in the NetBeans and Idea profiles only. Measured in the
    assembled cluster: no shipped keybinding file or Keymaps shadow binds
    F12 in those two, while the defaults module binds it in Eclipse
    (Switch to Recent Document), Emacs and NetBeans55 (Jump Next) - a
    profile's own meaning of a chord wins there, the 3.1.0 rule.
    KeymapProfileParityTest holds the scope and VsCodeKeymapResolutionTest
    resolves the chord through the assembled cluster.
-->
<bindings>
    <bind actionName="goto-declaration" key="F12"/>
</bindings>
