#!/bin/sh
# nmox - open a folder or files in NMOX Studio from a terminal:
#
#     cd myproject && nmox .
#
# Shipped as bin/nmox in the tar.gz and linked as /usr/bin/nmox by the .deb.
# It finds bin/nmoxstudio beside itself through any symlink, so a link from
# ~/.local/bin works as well as the package's own.
#
# Paths are made absolute and given their verb: a folder is AIMED (--aim,
# what File > Open Folder... does, with or without a manifest - the
# platform's own --open shows a manifest-less folder as a raw explorer tab),
# a file is OPENED (--open). Options, and the value an option takes, pass
# through untouched. Bare `nmox` just starts the IDE.
#
# A name that is not there is refused HERE, before anything starts:
# `nmox: <name>: no such file or folder` on stderr and exit status 2 - for a
# bare name, and for the value of an explicit --aim or --open (--aim also
# refuses a file: it takes a folder). The IDE below is started with its
# output discarded, so a refusal it made would reach nobody; the platform's
# own --aim refusal still speaks to whoever runs bin/nmoxstudio directly.
#
# The IDE starts in the BACKGROUND and the command returns at once, as
# `code .` does: it must neither hold the shell until the IDE quits nor die
# when the terminal closes. When the IDE is already running, the launcher
# is a short-lived client that hands its arguments to the running instance
# (the platform's CLI handshake). For the IDE in the foreground, with its
# console output, run bin/nmoxstudio (or nmox-studio) instead.
#
# The macOS bundle launcher (packaging/macos/build-dmg.sh) spells the same
# rule; TerminalCommandGateTest holds the two to the same argv.
PRG=$0
while [ -h "$PRG" ]; do
    link=$(readlink "$PRG")
    case "$link" in
        /*) PRG=$link ;;
        *)  PRG=$(dirname "$PRG")/$link ;;
    esac
done
BIN=$(CDPATH= cd -- "$(dirname "$PRG")" && pwd)
if [ ! -f "$BIN/nmoxstudio" ]; then
    echo "nmox: cannot find nmoxstudio beside $PRG" >&2
    exit 1
fi
n=$#
value=no
while [ "$n" -gt 0 ]; do
    a=$1
    shift
    n=$((n - 1))
    if [ "$value" != no ]; then
        if [ "$value" = --aim ] || [ "$value" = --open ]; then
            if [ ! -e "$a" ]; then
                printf 'nmox: %s: no such file or folder\n' "$a" >&2
                exit 2
            elif [ "$value" = --aim ] && [ ! -d "$a" ]; then
                printf 'nmox: %s: not a folder (--aim takes a folder)\n' "$a" >&2
                exit 2
            fi
        fi
        set -- "$@" "$a"
        value=no
        continue
    fi
    case "$a" in
        --userdir|--cachedir|--jdkhome|--open|--aim|--locale|--laf|--fontsize|--branding|--clusters)
            set -- "$@" "$a"
            value=$a ;;
        -*) set -- "$@" "$a" ;;
        *)  if [ -d "$a" ]; then
                set -- "$@" --aim "$(CDPATH= cd -- "$a" && pwd)"
            elif [ -e "$a" ]; then
                set -- "$@" --open "$(CDPATH= cd -- "$(dirname -- "$a")" && pwd)/$(basename -- "$a")"
            else
                printf 'nmox: %s: no such file or folder\n' "$a" >&2
                exit 2
            fi ;;
    esac
done
if [ "$value" != no ]; then
    printf 'nmox: %s needs a value\n' "$value" >&2
    exit 2
fi
nohup /bin/sh "$BIN/nmoxstudio" "$@" </dev/null >/dev/null 2>&1 &
exit 0
