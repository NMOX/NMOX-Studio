* text=auto

# Vendored third-party artifacts ship byte-verbatim (NOTICE sha256 depends on it)
editor/src/main/release/jsdebug/** -text
editor/src/main/resources/org/nmox/studio/editor/grammars/*.tmLanguage.json -text

# The bundled website ships byte-verbatim: a11y.css/i18n.js must equal the
# kits' own \n output on every OS (SiteShipsTest.kitParity — a windows
# autocrlf checkout broke the parity before this line existed)
ui/src/main/release/website/** -text

# Key material is byte-stable: KEYS carries PGP armor + an X.509 PEM
KEYS -text

# cmd.exe reads a batch file line by line and needs CRLF to do it reliably
*.cmd text eol=crlf

# Git for Windows sh runs this file: a CR would end every line with one
packaging/windows/nmox text eol=lf

# The Linux/macOS terminal launcher is a shell script, and gates read it
# for git's setup lines: a windows autocrlf checkout gave it CRLF and
# GitSetupTest.helpAgrees failed on the first line it matched (3.2.0 CI)
packaging/linux/nmox text eol=lf
